# Client2Freelancer Backend — environment template (copy to .env)
ARC_RPC_URL=https://rpc.testnet.arc.network
CONTRACT_ADDRESS=0xa12b4775b2eb4741aabbb8e2aade41e9ad0665e4
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CHAIN_NAME=Arc Testnet
CHAIN_ID=5042002
POLL_SECONDS=8
RECENT_BLOCKS=2000
# Small window scanned every poll cycle so the live feed stays current even on
# a rate-limited RPC; backfill covers older blocks gradually.
RECENT_SCAN_BLOCKS=400
BACKFILL_BLOCKS=60000
MAX_SCAN_BLOCKS=2000
ESCROWS_CACHE_TTL=15
# List/summary caps — SAMPLE_ESCROWS is used once the chain exceeds MAX_ESCROWS.
MAX_ESCROWS=100
SAMPLE_ESCROWS=12
# Safety Center cache TTL (seconds)
SAFETY_CACHE_TTL=10

# AI support assistant — optional. Rule-based FAQ answers work without a key.
# Free Gemini API key: https://aistudio.google.com/app/apikey (get one, paste below)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
