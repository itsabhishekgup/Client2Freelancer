# ArcBridge Backend — environment template (copy to .env)
ARC_RPC_URL=https://rpc.testnet.arc.network
CONTRACT_ADDRESS=0x788bd809f93b8915f0dcd1ab3b3560355c8d0ff3
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CHAIN_NAME=Arc Testnet
CHAIN_ID=5042002
POLL_SECONDS=8
RECENT_BLOCKS=2000
BACKFILL_BLOCKS=60000
MAX_SCAN_BLOCKS=2000
ESCROWS_CACHE_TTL=15

# AI support assistant — optional. Rule-based FAQ answers work without a key.
# Free Gemini API key: https://aistudio.google.com/app/apikey (get one, paste below)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Circle User-Controlled Wallets (optional — "Connect with Circle" email OTP or PIN login)
# Get these from the Circle Web3 Services console (https://console.circle.com)
# Full key format: TEST_API_KEY:<id>:<secret> (keep the whole string)
CIRCLE_API_KEY=
# Entity secret (console) + App ID (console, needed for web SDK + both logins)
CIRCLE_ENTITY_SECRET=
CIRCLE_APP_ID=
